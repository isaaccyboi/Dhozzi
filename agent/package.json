{
  "name": "dhozzi-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A cost-aware terminal coding agent built on the Claude API.",
  "bin": {
    "dhozzi-agent": "./dist/index.js"
  },
  "scripts": {
